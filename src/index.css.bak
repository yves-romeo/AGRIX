@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  html {
    -webkit-font-smoothing: antialiased;
    -webkit-tap-highlight-color: transparent;
  }
  body {
    @apply bg-slate2-50 text-slate2-800 font-sans antialiased;
    font-feature-settings: 'cv11', 'ss01';
  }
  * {
    -webkit-overflow-scrolling: touch;
  }
}

@layer components {
  .card {
    @apply bg-white rounded-xl border border-slate2-200/70 shadow-soft;
  }
  .card-hover {
    @apply transition-all duration-200 hover:shadow-card hover:-translate-y-0.5;
  }
  .btn-primary {
    @apply inline-flex items-center justify-center gap-2 rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white shadow-soft transition-all hover:bg-forest-700 active:scale-[0.98] disabled:opacity-50;
  }
  .btn-ghost {
    @apply inline-flex items-center justify-center gap-2 rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-slate2-700 border border-slate2-200 transition-all hover:bg-slate2-50 active:scale-[0.98];
  }
  .chip {
    @apply inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium;
  }
  .scrollbar-thin::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background: rgba(100, 116, 139, 0.25);
    border-radius: 9999px;
  }
  .scrollbar-thin::-webkit-scrollbar-track {
    background: transparent;
  }
}

/* Hide scrollbar on horizontal tickers */
.no-scrollbar::-webkit-scrollbar { display: none; }
.no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

.leaflet-container {
  background: #0f172a;
}

.leaflet-control-attribution {
  display: none !important;
}
